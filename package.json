{
  "name": "viyaapp",
  "version": "3.0.0",
  "description": "Examples of Browser Applications for SAS Viya",
  "main": "app.js",
  "scripts": {
    "start": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npx @sassoftware/viya-serverjs --env=./.env --docker=./Dockerfile",
    "submit": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 APPENTRY=submit.html npx @sassoftware/viya-serverjs --env=./.env --docker=./Dockerfile",
    "runsh": "bash startup.sh",
    "push2acr": "bash ./push2acr.sh",
    "deploy": "bash ./deploy.sh",
    "indocker": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node index.js"
  },
  "keywords": [
    "SAS",
    "SAS Viya",
    "JavaScript",
    "Node.js",
    "@sassoftware/viya-serverjs",
    "@sassoftware/restaf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sassoftware/viya-serverjs": "^0.3.0",
    "cross-env": "^10.0.0"
  }
}
