{
  "name": "@sassoftware/smart-controls-mui",
  "version": "1.12.0",
  "author": "K. Deva Kumar",
  "license": "Apache-2.0",
  "description": "Mui Frame Controls for use with @sassoftware/react-app-builder",
  "source": "./index.js",
  "packDirectory": "./dev",
  "exports": {
    "default": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "browser": "./dist/index.js",
  "unpkg": "./dist/index.js",
  "files": [
    "./dist",
    "./lib",
    "LICENSE"
  ],
  "scripts": {
    "src2": "babel src --out-dir src2",
    "build:rollup": "rimraf esm && rollup -c --bundleConfigAsCjs",
    "pub": "npm publish --tag latest --access public",
    "build:umdd": "rimraf lib && webpack --env target=umd p=n --config webpack.config.js",
    "build:umdp": "rimraf dist && webpack --env target=umd p=y --config webpack.config.js",
    "build:umd": "npm run build:umdd && npm run build:umdp",
    "build": "npm run build:umd",
    "buildall": "npm run build && npm run build:rollup",
    "stats": "webpack --env target=umd p=a --config webpack.config.js",
    "bump": "npm version prerelease"
  },
  "dependencies": {
    "@babel/cli": "^7.21.5",
    "@babel/core": "^7.24.5",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^5.15.16",
    "@mui/joy": "^5.0.0-beta.48",
    "@mui/material": "^5.15.16",
    "@mui/x-data-grid": "^7.22.2",
    "@react-hook/size": "^2.1.2",
    "@sassoftware/restaf": "^5.3.1",
    "@sassoftware/restafedit": "^3.0.2",
    "@sassoftware/restaflib": "^5.3.1",
    "@types/react": "^18.3.12",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "btoa": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.19.1",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@svgr/webpack": "^6.5.1",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.31.11",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.4.49",
    "prettier": "^2.8.0",
    "prettier-eslint": "^15.0.1",
    "prettier-eslint-cli": "^7.1.0",
    "rimraf": "^5.0.10",
    "rollup": "^4.26.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "resolutions": {
    "**/@svgr/webpack": "8.0.1",
    "**/fix": "0.0.6",
    "**/json5": "2.2.0",
    "**/nth-check": "^2.0.1",
    "**/underscore.string": "3.3.6",
    "**/rimraf": "^5.0.7",
    "**/glob": "^11.0.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
