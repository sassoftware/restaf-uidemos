{
  "name": "@sassoftware/smart-controls-mui",
  "version": "0.23.0",
  "author": "K. Deva Kumaraswamy",
  "license": "Apache-2.0",
  "description": "Mui Frame Controls for use with @sassoftware/FrameBuilder",
  "source": "./index.js",
  "exports": {
    "require": "./dist/index.cjs",
    "default": "./dist/index.esm.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "unpkg": "./dist/index.umd.js",
  "files": [
    "./dist"
  ],
  "scripts": {
    "stats": "webpack --env target=umd p=a --config webpack.config.js",
    "build:lib": "microbundle --visualize  --name smartControls --jsx React.createElement --jsxFragment React.Fragment",
    "build:umd": "webpack --env target=umd p=n --config webpack.config.js",
    "build": "rimraf dist && npm run build:lib && npm run build:umd",
    "pub": "npm publish --tag dev --access public"
  },
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/preset-env"
    ]
  },
  "dependencies": {
    "@babel/cli": "^7.21.5",
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-private-property-in-object": "^7.24.5",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^5.15.16",
    "@mui/joy": "^5.0.0-beta.48",
    "@mui/material": "^5.15.16",
    "@react-hook/size": "^2.1.2",
    "btoa": "^1.2.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.19.1",
    "@svgr/webpack": "^6.5.1",
    "babel-loader": "^9.1.3",
    "eslint": "^8.28.0",
    "eslint-plugin-react": "^7.31.11",
    "microbundle": "^0.15.1",
    "prettier": "^2.8.0",
    "prettier-eslint": "^15.0.1",
    "prettier-eslint-cli": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.7",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "@sassoftware/restaf": "^5.2.4",
    "@sassoftware/restafedit": "^3.0.0-alpha.3",
    "@sassoftware/restaflib": "^5.2.4"
  },
  "resolutions": {
    "**/@svgr/webpack": "8.0.1",
    "**/fix": "0.0.6",
    "**/json5": "2.2.0",
    "**/nth-check": "^2.0.1",
    "**/underscore.string": "3.3.6"
  }
}
