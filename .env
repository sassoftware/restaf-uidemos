APPHOST=localhost
# APPENTRY=index.html
APPLOC=./public
# VIYA_SERVER=
# VIYA_SERVER=none
APPPORT=8080
APPNAME=viyaapp
AUTHFLOW=server
CLIENTID=viyaapp
CLIENTSECRET=jellico
REDIRECT=
# APPDIR=./appDir
HTTPS=true

// browsers do not accept self-signed certs from localhost
// so run all apps thru the proxy and call Viya from there
// Also need a valid cert for production use
// For use with dev use mkcert to create a local CA and certs

APPENV_PROXYSERVER=https://localhost:8080/viyaapp/proxy
USETOKEN=YES
SHOWENV=YES

APPENV_XYZ=AA
APPENV_BAD=





